<!DOCTYPE html>
<html lang="en">
<head>
    <title>MVC User Management</title>
</head>
<body>
    <h1>Active Users</h1>
    <ul>
        <% users.forEach(user => { %>
            <li><%= user.name %></li>
        <% }) %>
    </ul>

    <h2>Add User</h2>
    <form action="/users/add" method="POST">
        <input type="text" name="name" placeholder="Enter user name" required />
        <button type="submit">Submit</button>
    </form>
</body>
</html>
